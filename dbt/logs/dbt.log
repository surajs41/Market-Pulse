        rows between 49 preceding and current row
    ) as ma_50,
    close / nullif(avg(close) over (
        partition by ticker
        order by date
        rows between 19 preceding and current row
    ), 0) as price_vs_ma20
from "marketpulse"."analytics"."stg_daily_prices"
  );
  

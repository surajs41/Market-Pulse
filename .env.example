# ── Postgres (app data + shared host for Airflow metadata) ──────────────
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=marketpulse

# Separate database for Airflow internal metadata (not market data tables)
AIRFLOW_DB=airflow

# ── MinIO (S3-compatible object storage) ────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# Client settings for scripts run from the host (use minio:9000 inside Docker)
# Airflow containers override MINIO_ENDPOINT to minio:9000 via docker-compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio

# ── Airflow ─────────────────────────────────────────────────────────────
# On Linux/macOS, set to your UID:  id -u
# On Windows with Docker Desktop, 50000 is a safe default.
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_fernet_key

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_airflow

# ── Redpanda (Kafka-compatible streaming) ─────────────────────────────────
# Host scripts use localhost:9092 (EXTERNAL listener).
# Airflow / Docker services use redpanda:29092 (INTERNAL listener, set in docker-compose.yml).
REDPANDA_BROKERS=localhost:9092

# Delay between simulated tick messages in streaming/tick_producer.py (seconds)
TICK_INTERVAL_SECONDS=0.5

# ── Postgres client settings (host scripts) ───────────────────────────────
# Docker services use the hostname "postgres"; scripts on the host use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── dbt (transformation layer) ────────────────────────────────────────────
# Points dbt at dbt/profiles.yml (credentials read via env_var in that file)
DBT_PROFILES_DIR=./dbt

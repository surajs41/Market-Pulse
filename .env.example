# ── Postgres (app data + shared host for Airflow metadata) ──────────────
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=marketpulse

# Separate database for Airflow internal metadata (not market data tables)
AIRFLOW_DB=airflow

# ── MinIO (S3-compatible object storage) ────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# Client settings for scripts run from the host (use minio:9000 inside Docker)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio

# ── Airflow ─────────────────────────────────────────────────────────────
# On Linux/macOS, set to your UID:  id -u
# On Windows with Docker Desktop, 50000 is a safe default.
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_fernet_key

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_airflow
